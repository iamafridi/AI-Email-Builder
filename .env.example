# LLM Provider — leave all empty to use rule-based fallback
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OLLAMA_HOST=

# Email source: "mock" or "csv" or "imap"
EMAIL_MODE=mock

# CSV file path (only needed if EMAIL_MODE=csv)
CSV_MOCK_FILE=backend/mock_emails.csv

# How often to poll (seconds)
POLL_INTERVAL_SECONDS=30

# IMAP settings (only needed if EMAIL_MODE=imap)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
